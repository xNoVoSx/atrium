{
  "name": "atrium-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end tests against a real Home Assistant. Configure ../.env (see .env.example).",
  "scripts": {
    "install-browser": "PLAYWRIGHT_BROWSERS_PATH=.browsers playwright install chromium",
    "test": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env run.mjs",
    "update-check": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env update-check.mjs",
    "app": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env android/run.mjs",
    "edit": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env edit.mjs",
    "tour": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env tour.mjs",
    "designs": "PLAYWRIGHT_BROWSERS_PATH=.browsers node --env-file-if-exists=../.env designs.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
