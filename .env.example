# Local settings for scripts/deploy.mjs and e2e/. Copy to .env (never committed).

# Home Assistant to deploy to and test against
ATRIUM_HA_URL=http://homeassistant.local:8123
# File holding a long-lived access token of an admin user
ATRIUM_ADMIN_TOKEN_FILE=/path/to/ha-token

# Deploy: SSH target with write access to /config (e.g. the "Terminal & SSH" add-on)
ATRIUM_SSH_TARGET=root@homeassistant.local
# Extra ssh/scp options, e.g. "-F /path/to/ssh_config"
ATRIUM_SSH_OPTS=
# Set to 1 to tunnel SSH through the HTTP proxy in $HTTP_PROXY (needs socat)
ATRIUM_SSH_VIA_HTTP_PROXY=0

# E2E: a non-admin test user (file with lines username=... and password=...)
ATRIUM_TEST_USER_FILE=/path/to/test-user
# E2E: the only light the tests may switch; its state is restored afterwards
ATRIUM_TEST_LIGHT=light.example
